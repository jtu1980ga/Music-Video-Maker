# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VIDIQ_API_KEY: VidIQ API key for VidIQ MCP server authentication.
VIDIQ_API_KEY="MY_VIDIQ_API_KEY"

# VIDIQ_MCP_URL: VidIQ Model Context Protocol endpoint.
VIDIQ_MCP_URL="https://mcp.vidiq.com/mcp"

# VIDIQ_CLIENT_ID & VIDIQ_CLIENT_SECRET: For VidIQ OAuth 2.0 Web Authorization.
# Optional - if not provided, the app will use direct API Key or authenticated session.
VIDIQ_CLIENT_ID=""
VIDIQ_CLIENT_SECRET=""

# YOUTUBE_CLIENT_ID & YOUTUBE_CLIENT_SECRET: For direct YouTube upload authorization.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# GROQ_API_KEY: High-speed Whisper API key (e.g. gsk_...) for timestamped lyric transcription when Gemini is in high demand.
GROQ_API_KEY=""

